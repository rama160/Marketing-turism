{
  "name": "marketing-turism-agent",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marketing-turism-db",
      "database_id": "d2409026-8e01-43b0-8e4c-8fa0617f45dc",
      "migrations_dir": "database/migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/photos/*"
    ]
  },
  "vars": {
    "PUBLIC_LEADS_ENABLED": "false",
    "META_APPROVED_AUTOPOST_ENABLED": "true",
    "GROWTH_PUBLIC_RESEARCH_ENABLED": "true",
    "META_EXTERNAL_POST_DATES": "2026-10-26,2026-10-28,2026-10-30"
  },
  "triggers": {
    "crons": [
      "0 1 * * 1",
      "0 2 * * *",
      "0 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "PHOTO_KV",
      "id": "75b81d83ac954e57a2976c651470dc85"
    }
  ]
}
